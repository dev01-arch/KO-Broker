# ============================================
# KO Broker Platform — Web App Environment Variables
# ============================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to the repository — it contains secrets.
#
# Variables prefixed NEXT_PUBLIC_ are exposed to the browser.
# All others are server-side only.
# ============================================


# ── DATABASE (Supabase / PostgreSQL) ─────────────────────────────────────────
# Pooler URL — Transaction mode, port 6543. Used by the app at runtime.
# Add ?pgbouncer=true to enable pgbouncer compatibility.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&pool_timeout=30
# Direct URL — Session mode, port 5432. Used by Prisma CLI only (migrate, seed).
DIRECT_URL=postgresql://postgres.<project-ref>:<password>@aws-0-eu-west-1.pooler.supabase.com:5432/postgres?connection_limit=1&pool_timeout=30


# ── AUTHENTICATION (Clerk) ───────────────────────────────────────────────────
# Publishable key — safe to expose in the browser
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
# Secret key — server-side only. Never prefix with NEXT_PUBLIC_.
CLERK_SECRET_KEY=sk_test_...
# Webhook signing secret (svix) — copy from Clerk Dashboard > Webhooks
CLERK_WEBHOOK_SECRET=whsec_...

# Clerk redirect URLs
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard


# ── AI — OpenRouter ──────────────────────────────────────────────────────────
# API key from https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-...
# Model identifier. Default: google/gemini-2.5-flash
OPENROUTER_MODEL=google/gemini-2.5-flash


# ── AI — Azure AI Foundry (alternative to OpenRouter) ────────────────────────
# Endpoint URL from your Azure AI Foundry resource
AZURE_AI_FOUNDRY_ENDPOINT=https://your-resource.openai.azure.com/
# API key for the Azure AI Foundry resource
AZURE_AI_FOUNDRY_API_KEY=your-azure-api-key
# Deployed model name (e.g. gpt-4o, gpt-4o-mini)
AZURE_AI_FOUNDRY_DEPLOYMENT_NAME=gpt-4o


# ── EMAIL (Resend) ────────────────────────────────────────────────────────────
# API key from https://resend.com/api-keys
RESEND_API_KEY=re_...
# Verified sender address — domain must be verified in Resend dashboard
RESEND_FROM_EMAIL=notifications@yourdomain.co.uk
# Optional: display name in the From header (e.g. "KO Platform")
RESEND_FROM_NAME=KO Platform
# Optional: reply-to address
RESEND_REPLY_TO=support@yourdomain.co.uk
# Optional: webhook signing secret for Resend inbound email webhooks
# RESEND_WEBHOOK_SECRET=whsec_...


# ── SMS (Twilio) ──────────────────────────────────────────────────────────────
# Account SID — from https://console.twilio.com
TWILIO_ACCOUNT_SID=AC...
# Auth token — from https://console.twilio.com (keep secret)
TWILIO_AUTH_TOKEN=
# Verified Twilio phone number in E.164 format (e.g. +44...)
TWILIO_FROM_NUMBER=+44...


# ── FILE STORAGE (Cloudflare R2) ──────────────────────────────────────────────
# Cloudflare account ID — from Cloudflare Dashboard > R2
R2_ACCOUNT_ID=
# R2 API credentials — generate in Cloudflare R2 Dashboard > Manage API Tokens
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# R2 bucket name for document storage
R2_BUCKET_NAME=ko-broker-docs
# Public URL for the R2 bucket (custom domain or .r2.dev subdomain)
R2_PUBLIC_URL=https://storage.yourdomain.co.uk


# ── BILLING (Stripe) ──────────────────────────────────────────────────────────
# Use test keys for development — https://dashboard.stripe.com/test/apikeys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
# Webhook signing secret — from Stripe Dashboard > Webhooks
# Local testing: stripe listen --forward-to localhost:3001/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Price IDs — create in Stripe Dashboard > Products
# Plans: Starter £35/mo, Professional £50/mo, Enterprise £75/mo
STRIPE_PRICE_STARTER_MONTHLY=price_...
STRIPE_PRICE_STARTER_YEARLY=price_...
STRIPE_PRICE_PROFESSIONAL_MONTHLY=price_...
STRIPE_PRICE_PROFESSIONAL_YEARLY=price_...
STRIPE_PRICE_ENTERPRISE_MONTHLY=price_...
STRIPE_PRICE_ENTERPRISE_YEARLY=price_...


# ── APPLICATION URLs ──────────────────────────────────────────────────────────
# Public URL of the broker dashboard app
NEXT_PUBLIC_APP_URL=http://localhost:3001
# Internal API base URL (same as APP_URL for self-contained Next.js apps)
NEXT_PUBLIC_API_URL=http://localhost:3001
# Public URL of the client portal app (separate Next.js app on port 3002)
NEXT_PUBLIC_CLIENT_PORTAL_URL=http://localhost:3002


# ── SECURITY ──────────────────────────────────────────────────────────────────
# Secret for signing client portal session JWT cookies — required in production
# Generate: openssl rand -hex 32
PORTAL_SESSION_SECRET=change-me-in-production
# Allowed CORS origins for API routes (comma-separated, optional)
# CORS_ALLOWED_ORIGINS=https://app.yourdomain.co.uk,https://portal.yourdomain.co.uk


# ── CRON JOBS ─────────────────────────────────────────────────────────────────
# Shared secret that authorises scheduled cron requests.
# All four cron routes validate: Authorization: Bearer {CRON_SECRET}
# Required in production. Generate: openssl rand -hex 32
CRON_SECRET=change-me-in-production

# Message email digest delay (optional tuning)
# Default: 4 hours. Override for testing:
# MESSAGE_EMAIL_DIGEST_DELAY_HOURS=4
# MESSAGE_EMAIL_DIGEST_DELAY_MS=60000


# ── FCA FS REGISTER API (PRD-16 — lender directory sync) ─────────────────────
# Used by GET/POST /api/cron/lenders-fca — runs monthly on the 1st.
# Without these the cron returns HTTP 503 (lender search still works from seed).
# Free registration: https://register.fca.org.uk/developer/s/
FCA_API_EMAIL=your@email.com
FCA_API_KEY=your-fca-api-key


# ── FEATURE FLAGS (optional) ──────────────────────────────────────────────────
# Enforce Stripe plan limits in the UI and API
# KO_ENFORCE_PLAN_LIMITS=true
# NEXT_PUBLIC_ENFORCE_PLAN_LIMITS=true
