# ============================================
# KO Broker Platform — Environment Variables
# ============================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to the repository.
# ============================================


# ── AUTHENTICATION (Clerk) ───────────────────────────────────────────────────
# Publishable key — safe to expose in the browser
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
# Secret key — server-side only
CLERK_SECRET_KEY=sk_test_...
# Webhook signing secret (svix) — copy from Clerk Dashboard > Webhooks
CLERK_WEBHOOK_SECRET=whsec_...

# Clerk redirect URLs
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard


# ── DATABASE (Supabase / PostgreSQL) ─────────────────────────────────────────
# Pooler URL — used by the app at runtime (port 6543, Transaction mode)
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-eu-west-2.pooler.supabase.com:6543/postgres?pgbouncer=true
# Direct URL — used by prisma migrate only (port 5432, bypasses pooler)
DIRECT_URL=postgresql://postgres.<project-ref>:<password>@db.<project-ref>.supabase.co:5432/postgres


# ── AI (OpenRouter) ──────────────────────────
# API key for OpenRouter
OPENROUTER_API_KEY=""
# OpenRouter model to use (e.g. openrouter/free)
OPENROUTER_MODEL="openrouter/free"

# ── EMAIL (Resend) ───────────────────────────────────────────────────────────
# API key from https://resend.com/api-keys
RESEND_API_KEY=re_...
# Verified sender email address (must be verified in Resend dashboard)
RESEND_FROM_EMAIL=noreply@koplatform.co.uk


# ── SMS (Twilio) ─────────────────────────────────────────────────────────────
# Account SID — from https://console.twilio.com
TWILIO_ACCOUNT_SID=AC...
# Auth token — from https://console.twilio.com
TWILIO_AUTH_TOKEN=
# Verified Twilio phone number (e.g. +44...)
TWILIO_FROM_NUMBER=+44...


# ── STORAGE (Cloudflare R2) ──────────────────────────────────────────────────
# R2 Account ID — from Cloudflare Dashboard > R2
R2_ACCOUNT_ID=
# R2 API token credentials (S3-compatible)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Bucket name
R2_BUCKET_NAME=ko-broker-docs
# Public R2 URL (custom domain or r2.dev subdomain)
R2_PUBLIC_URL=https://storage.koplatform.co.uk


# ── BILLING (Stripe) ─────────────────────────────────────────────────────────
# Secret key — from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
# Webhook signing secret — from Stripe Dashboard > Webhooks (after creating endpoint)
STRIPE_WEBHOOK_SECRET=whsec_...
# Publishable key — safe to expose in the browser
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...


# ── APP ──────────────────────────────────────────────────────────────────────
# Base URL of this app (used for webhook callbacks, email links, etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3000
