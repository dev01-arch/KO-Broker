// KO Broker Platform — Prisma Schema
// PRD-03: Database Schema & Supabase Setup
// All IDs use @default(cuid()). All timestamps use @default(now()).
// Every table has orgId except User and LenderCriteria.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ── Enums ──────────────────────────────────────

enum Plan {
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

enum Role {
  ADMIN
  ADVISER
  COMPLIANCE
  VIEWER
}

enum EmploymentStatus {
  EMPLOYED
  SELF_EMPLOYED
  CONTRACTOR
  RETIRED
  UNEMPLOYED
}

enum ClientType {
  INDIVIDUAL
  COMPANY
}

enum ClientStatus {
  PROSPECT
  ACTIVE
  INACTIVE
}

enum CaseType {
  PURCHASE
  REMORTGAGE
  BTL
  FURTHER_ADVANCE
  PRODUCT_TRANSFER
}

enum CaseStage {
  ENQUIRY
  FACT_FIND
  RESEARCH
  DIP
  OFFER
  COMPLETION
  ARCHIVED
}

enum ReportTemplate {
  BTL
  FTB
  REMORTGAGE
  HOME_MOVER
  PRODUCT_TRANSFER
  DIVORCE
  SELF_EMPLOYED
  VULNERABLE_OVERLAY
}

enum ReportStatus {
  DRAFT
  ADVISER_REVIEW
  APPROVED
  FINALISED
}

enum MessageDirection {
  INBOUND
  OUTBOUND
  SYSTEM
}

enum MessageChannel {
  EMAIL
  SMS
  IN_APP
}

enum MessageSource {
  CASE_UPDATE
  COMPLIANCE
  AI_REPORT
  CLIENT_REPLY
  SYSTEM
}

enum DocumentType {
  ID
  INCOME
  FINANCIAL
  LENDER
  COMPLIANCE
  OTHER
}

// ── PRD-15: Mortgage Intelligence enums ────────────────────────────────────────

enum IntelligenceSource {
  MANUAL
  CONFIRMED_FROM_CASE
}

enum MarketSignal {
  IMPROVING
  STABLE
  WORSENING
}

// ── PRD-16: Lender directory + property + notes + info-requests enums ──────────

enum LenderStatus {
  ACTIVE
  INACTIVE
  LEGACY
}

enum LenderSource {
  SEED
  FCA
  OTHER
}

enum PropertyType {
  RESIDENTIAL
  BTL
  OTHER
}

enum CaseNoteSource {
  ADVISER
  INTEL
  SYSTEM
}

enum InfoRequestStatus {
  OUTSTANDING
  FULFILLED
  CANCELLED
}

// ── Models ─────────────────────────────────────

model Organisation {
  id               String   @id @default(cuid())
  name             String
  slug             String   @unique
  plan             Plan     @default(STARTER)
  stripeCustomerId String?
  settings         Json?    @default("{}")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  users                    User[]
  members                  OrganisationMember[]
  clients                  Client[]
  cases                    Case[]
  caseIntelligenceSnapshots CaseIntelligenceSnapshot[]
  properties               Property[]

  @@map("organisations")
}

model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  email     String
  firstName String?
  lastName  String?
  role      Role     @default(ADVISER)
  isActive  Boolean  @default(true)
  orgId     String?

  // Adviser invite (broker-side) — from backend API layer
  inviteToken       String?  @unique
  inviteTokenExpiry DateTime?
  invitePending     Boolean  @default(false)

  // Per-adviser visibility switches (ADMIN always bypasses) — from backend API layer
  canViewAllClients     Boolean @default(false)
  canViewAccountDetails Boolean @default(false)
  canViewAiSummaries    Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organisation       Organisation?       @relation(fields: [orgId], references: [id])
  organisationMember OrganisationMember?
  assignedCases      Case[]              @relation("CaseAdviser")
  complianceRecords  ComplianceRecord[]
  suitabilityReports SuitabilityReport[]
  auditLogs          AuditLog[]
  caseNotes          CaseNote[]          @relation("CaseNoteAuthor")

  @@map("users")
}

model OrganisationMember {
  id        String   @id @default(cuid())
  orgId     String
  firstName String
  lastName  String
  email     String
  role      Role     @default(ADVISER)
  isActive  Boolean  @default(true)
  userId    String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organisation Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  clients      Client[]

  @@unique([orgId, email])
  @@map("organisation_members")
}

model Client {
  id               String           @id @default(cuid())
  orgId            String
  referenceNumber  String
  clientType       ClientType       @default(INDIVIDUAL)
  companyName      String?
  companyNumber    String?
  title            String?
  firstName        String
  lastName         String
  email            String
  phone            String?
  dateOfBirth      DateTime?
  niNumber         String?
  address          Json?
  employmentStatus EmploymentStatus @default(EMPLOYED)
  annualIncome     Float?
  isReferred       Boolean          @default(false)
  referredToCompany String?
  assignedMemberId String?
  status           ClientStatus     @default(PROSPECT)
  insurerName      String?
  isVulnerable     Boolean          @default(false)
  vulnerabilityNotes String?
  portalEnabled    Boolean          @default(false)
  portalAccessToken String?         @unique
  portalPasswordHash String?
  /// Personal portal prefs, e.g. { emailMessages: boolean } — default ON when missing
  notificationPrefs Json?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  organisation   Organisation        @relation(fields: [orgId], references: [id])
  assignedMember OrganisationMember? @relation(fields: [assignedMemberId], references: [id], onDelete: SetNull)
  cases          Case[]
  documents      Document[]
  messages       Message[]
  properties     Property[]
  infoRequests   ClientInfoRequest[]

  @@unique([orgId, referenceNumber])
  @@map("clients")
}

model Case {
  id              String    @id @default(cuid())
  orgId           String
  clientId        String
  referenceNumber String
  type            CaseType
  stage           CaseStage @default(ENQUIRY)
  propertyValue   Float?
  loanAmount      Float?
  ltv             Float?
  termYears       Int?
  selectedLender  String?
  selectedProduct String?
  selectedRate    Float?
  selectedFee     Float?
  adviserNotes    String?
  assignedAdviserId String?

  // ── PRD-16: Property FK ───────────────────────────────
  propertyId      String?

  // ── PRD-16: Lender FK (alongside selectedLender string during transition) ──
  lenderId        String?
  lenderOtherName String?

  // ── PRD-16: Date spine ────────────────────────────────
  aipAt           DateTime?
  submittedAt     DateTime?
  offerIssuedAt   DateTime?
  offerExpiresAt  DateTime?
  exchangeAt      DateTime?
  completionAt    DateTime?

  // ── PRD-16: Account strip ─────────────────────────────
  rateType          String?
  monthlyPayment    Float?
  initialRateEndsAt DateTime?
  chargeType        String?
  isOffset          Boolean?

  // ── PRD-16: Stale recommendation ──────────────────────
  recommendationStaleAt     DateTime?
  recommendationStaleReason String?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  organisation       Organisation       @relation(fields: [orgId], references: [id])
  client             Client             @relation(fields: [clientId], references: [id])
  adviser            User?              @relation("CaseAdviser", fields: [assignedAdviserId], references: [id])
  property           Property?          @relation(fields: [propertyId], references: [id])
  lender             Lender?            @relation("CaseLender", fields: [lenderId], references: [id])
  factFind           FactFind?
  productsConsidered ProductConsidered[]
  complianceRecords  ComplianceRecord[]
  suitabilityReports SuitabilityReport[]
  messages           Message[]
  documents          Document[]
  intelligenceSnapshots CaseIntelligenceSnapshot[]
  notes              CaseNote[]
  infoRequests       ClientInfoRequest[]

  @@unique([orgId, referenceNumber])
  @@map("cases")
}

model FactFind {
  id                  String   @id @default(cuid())
  caseId              String   @unique
  personalDetails     Json?
  employmentDetails   Json?
  incomeDetails       Json?
  expenditureDetails  Json?
  propertyDetails     Json?
  existingMortgages   Json?
  clientPreferences   Json?
  completedAt         DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  case Case @relation(fields: [caseId], references: [id])

  @@map("fact_finds")
}

model ProductConsidered {
  id                String   @id @default(cuid())
  caseId            String
  lenderName        String
  productName       String
  rate              Float?
  fee               Float?
  isSelected        Boolean  @default(false)
  reasonNotSelected String?

  // ── PRD-16: Lender FK + product detail fields ─────────
  lenderId          String?
  lenderOtherName   String?
  productType       String?
  initialTermMonths Int?
  ercSummary        String?

  createdAt         DateTime @default(now())

  case   Case    @relation(fields: [caseId], references: [id])
  lender Lender? @relation(fields: [lenderId], references: [id])

  @@map("products_considered")
}

model ComplianceRecord {
  id          String   @id @default(cuid())
  caseId      String
  stage       String
  completedAt DateTime @default(now())
  documentUrl String?
  isApproved  Boolean  @default(false)
  userId      String?
  createdAt   DateTime @default(now())

  case Case  @relation(fields: [caseId], references: [id])
  user User? @relation(fields: [userId], references: [id])

  @@map("compliance_records")
}

model SuitabilityReport {
  id           String       @id @default(cuid())
  caseId       String
  templateType ReportTemplate
  status       ReportStatus @default(DRAFT)
  sections     Json?
  pdfUrl       String?
  generatedBy  String?
  approvedBy   String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  case      Case  @relation(fields: [caseId], references: [id])
  generator User? @relation(fields: [generatedBy], references: [id])

  @@map("suitability_reports")
}

model Message {
  id         String           @id @default(cuid())
  orgId      String
  caseId     String?
  clientId   String?
  direction  MessageDirection
  channel    MessageChannel   @default(EMAIL)
  sourceType MessageSource    @default(SYSTEM)
  subject    String?
  body       String
  isRead     Boolean          @default(false)
  threadId   String?
  createdAt  DateTime         @default(now())

  case   Case?   @relation(fields: [caseId], references: [id])
  client Client? @relation(fields: [clientId], references: [id])

  @@map("messages")
}

/// LinkedIn-style delayed message notification email (one pending digest per recipient).
/// First message body is locked as the preview; later messages in the window do not change it.
model MessageEmailDigest {
  id             String    @id @default(cuid())
  orgId          String
  recipientEmail String
  recipientName  String?
  /// CLIENT = adviser→client notify; ADVISER = client→adviser notify
  recipientKind  String
  clientId       String?
  caseId         String?
  firstMessageId String
  previewBody    String
  subject        String?
  ctaUrl         String
  scheduledFor   DateTime
  /// PENDING | SENT | CANCELLED | SKIPPED
  status         String    @default("PENDING")
  sentAt         DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status, scheduledFor])
  @@index([orgId, recipientEmail, recipientKind, status])
  @@map("message_email_digests")
}

model Document {
  id           String       @id @default(cuid())
  orgId        String
  caseId       String?
  clientId     String?
  name         String
  documentType DocumentType @default(OTHER)
  storageUrl   String
  mimeType     String?
  sizeBytes    Int?
  uploadedBy   String?
  createdAt    DateTime     @default(now())

  case   Case?   @relation(fields: [caseId], references: [id])
  client Client? @relation(fields: [clientId], references: [id])

  @@map("documents")
}

model AuditLog {
  id               String   @id @default(cuid())
  orgId            String
  userId           String?
  entityType       String
  entityId         String
  action           String
  diff             Json?
  notificationSent Boolean  @default(false)
  createdAt        DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  // NOTE: No updatedAt — AuditLog is INSERT-ONLY per PRD-07
  @@map("audit_logs")
}

model LenderCriteria {
  id                     String   @id @default(cuid())
  lenderName             String   @unique
  maxLtv                 Float?
  minIncome              Float?
  maxLoanAmount          Float?
  acceptedEmploymentTypes String[]
  minCreditScore         Int?
  specialConditions      Json?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  // NOTE: Global reference data — no orgId

  @@map("lender_criteria")
}

// ── PRD-16: Lender directory ───────────────────────────────────────────────────

/// Global lender reference directory — no orgId.
/// Rows used on a case or product are never renamed or deleted.
/// LEGACY = closed brands kept for remortgage lookups (NRAM, Bradford & Bingley, etc.)
/// OTHER = reserved sentinel row for free-text override; source = OTHER, never deactivated.
model Lender {
  id             String       @id @default(cuid())
  name           String       @unique
  normalizedName String       @unique
  fcaFrn         String?
  status         LenderStatus @default(ACTIVE)
  source         LenderSource @default(SEED)
  lastSeenAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  productsConsidered ProductConsidered[]
  cases              Case[]              @relation("CaseLender")

  @@map("lenders")
}

// ── PRD-16: Property ───────────────────────────────────────────────────────────

/// Client-owned property record. Promoted off FactFind.propertyDetails JSON.
/// No top-level nav item — appears on client detail and case header only.
model Property {
  id           String       @id @default(cuid())
  orgId        String
  clientId     String
  address      Json?
  postcode     String
  tenure       String?
  type         PropertyType @default(RESIDENTIAL)
  currentValue Float?
  monthlyRent  Float?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  organisation Organisation @relation(fields: [orgId], references: [id])
  client       Client       @relation(fields: [clientId], references: [id])
  cases        Case[]

  @@map("properties")
}

// ── PRD-16: CaseNote ───────────────────────────────────────────────────────────

/// Append-only notes thread on a case. Replaces Case.adviserNotes (single string).
/// INSERT-ONLY — no UPDATE or DELETE in the API.
/// tag values: intel | disclosure | amend | system
model CaseNote {
  id           String         @id @default(cuid())
  orgId        String
  caseId       String
  body         String
  tag          String?
  authorUserId String?
  source       CaseNoteSource @default(ADVISER)
  createdAt    DateTime       @default(now())

  case   Case  @relation(fields: [caseId], references: [id])
  author User? @relation("CaseNoteAuthor", fields: [authorUserId], references: [id])

  @@map("case_notes")
}

// ── PRD-16: ClientInfoRequest ─────────────────────────────────────────────────

/// Tracks "request from client" actions. Outstanding until a matching document
/// is uploaded or the adviser confirms the checklist item.
model ClientInfoRequest {
  id                  String            @id @default(cuid())
  orgId               String
  caseId              String
  clientId            String
  checklistItemId     String?
  documentType        String?
  messageId           String?
  status              InfoRequestStatus @default(OUTSTANDING)
  fulfilledDocumentId String?
  createdAt           DateTime          @default(now())
  fulfilledAt         DateTime?

  case   Case   @relation(fields: [caseId], references: [id])
  client Client @relation(fields: [clientId], references: [id])

  @@map("client_info_requests")
}

// ── PRD-15: Mortgage Intelligence models ──────────────────────────────────────

/// One data point for a BoE statistical series (e.g. 2yr fixed quoted rate).
/// Rows are insert-only with open-ended validTo (closed when superseded).
/// Global reference data — no orgId.
model RateSeriesPoint {
  id          String    @id @default(cuid())
  seriesId    String
  label       String
  value       Float
  validFrom   DateTime
  validTo     DateTime?
  retrievedAt DateTime
  source      String
  rawRef      String?
  createdAt   DateTime  @default(now())

  @@index([seriesId, validFrom])
  @@map("rate_series_points")
}

/// Permanent cache of Postcodes.io lookup results keyed by (full or outward) postcode.
/// Never expires — stale only when address reorganisation happens (rare).
/// Global reference data — no orgId.
model PostcodeGeography {
  id            String   @id @default(cuid())
  postcode      String   @unique
  outwardCode   String
  lat           Float?
  lng           Float?
  region        String?
  adminDistrict String?
  lsoa          String?
  msoa          String?
  constituency  String?
  cachedAt      DateTime
  createdAt     DateTime @default(now())

  @@index([outwardCode])
  @@map("postcode_geography")
}

/// Outward-code level aggregated price stats from HMLR Price Paid Data.
/// Unique on (outwardCode, asOf) — the cron job upserts by that key.
/// Global reference data — no orgId.
model LocalPriceStat {
  id               String   @id @default(cuid())
  outwardCode      String
  asOf             DateTime
  medianPrice      Float
  medianPrice12m   Float?
  change12mPct     Float?
  txnCount12m      Int
  retrievedAt      DateTime
  source           String   @default("HMLR_PPD")

  @@unique([outwardCode, asOf])
  @@index([outwardCode])
  @@map("local_price_stats")
}

/// Status of each background data feed — updated by cron jobs on every run.
/// Keyed by feedId: 'BOE_RATES' | 'HMLR_PRICES'.
/// Global reference data — no orgId.
model DataFeedStatus {
  id            String    @id @default(cuid())
  feedId        String    @unique
  lastSuccessAt DateTime?
  lastAttemptAt DateTime?
  lastError     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("data_feed_status")
}

/// INSERT-ONLY record of a single "Mortgage Intelligence" generation run.
/// Two generates = two rows — never PATCH.
/// Scoped per org; caseId is optional (null for MANUAL snapshots).
model CaseIntelligenceSnapshot {
  id                 String            @id @default(cuid())
  orgId              String
  caseId             String?
  source             IntelligenceSource
  confirmedAt        DateTime?
  generatedAt        DateTime          @default(now())
  postcode           String
  outwardCode        String
  propertyValue      Float
  deposit            Float?
  mortgageAmount     Float
  termYears          Int
  grossIncome        Float?
  secondIncome       Float?
  monthlyCommitments Float?
  ltv                Float?
  lti                Float?
  dti                Float?
  dtiBand            String?
  monthlyPayment     Float?
  marketSignal       MarketSignal?
  insightText        String
  watchText          String?
  inputsJson         Json
  outputsJson        Json
  sourcesJson        Json
  createdAt          DateTime          @default(now())

  organisation Organisation @relation(fields: [orgId], references: [id])
  case         Case?        @relation(fields: [caseId], references: [id])

  @@index([orgId, generatedAt])
  @@index([orgId, caseId])
  @@map("case_intelligence_snapshots")
}
