# ============================================
# KO Broker Platform — Environment Variables
# ============================================
# Copy this file to .env and fill in your values.
# NEVER commit .env with real credentials to the repository.
# This file lives at the monorepo root and is read by packages/db for
# Prisma CLI commands (migrate, seed, studio).
# The web app reads from apps/web/.env.local at runtime.
# ============================================

# ── DATABASE (Supabase) ──────────────────────────────────────────────────────
# Pooler URL — Transaction mode, port 6543, used by the app at runtime
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&pool_timeout=30"
# Direct URL — Session mode, port 5432, used by Prisma CLI (migrate, seed, studio)
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-eu-west-1.pooler.supabase.com:5432/postgres?connection_limit=1&pool_timeout=30"
