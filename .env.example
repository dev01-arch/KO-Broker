# ============================================
# KO Broker Platform — Environment Variables
# ============================================
# This file documents ALL required environment variables for the platform.
# It contains placeholder values only — never real credentials.
#
# HOW TO USE:
#   1. Copy this file to .env at the monorepo root (used by Prisma CLI)
#   2. Copy apps/web/.env.local.example to apps/web/.env.local (used by the app)
#   3. Fill in your real values in both files
#   4. NEVER commit .env or .env.local — they are in .gitignore
#
# The monorepo root .env is only read by packages/db (Prisma CLI commands:
# migrate, seed, seed:lenders, studio). The Next.js app reads from
# apps/web/.env.local at runtime. Both files need DATABASE_URL and DIRECT_URL.
# ============================================


# ── DATABASE (Supabase / PostgreSQL) ─────────────────────────────────────────
# Supabase Dashboard → Project Settings → Database → Connection string
#
# Pooler URL — Transaction mode, port 6543.
# Used by the app at runtime. Append ?pgbouncer=true for pgbouncer compatibility.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&pool_timeout=30"
#
# Direct URL — Session mode, port 5432.
# Used ONLY by Prisma CLI (migrate, seed). Never used at runtime.
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-eu-west-1.pooler.supabase.com:5432/postgres?connection_limit=1&pool_timeout=30"


# ── AUTHENTICATION (Clerk) ───────────────────────────────────────────────────
# Clerk Dashboard → API Keys
# Publishable key — safe to expose in the browser (NEXT_PUBLIC_ prefix)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
# Secret key — server-side only, never expose to the browser
CLERK_SECRET_KEY=sk_test_...
# Webhook signing secret — Clerk Dashboard → Webhooks → signing secret
CLERK_WEBHOOK_SECRET=whsec_...

# Clerk redirect URLs (defaults for Next.js, change if you rename routes)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard


# ── AI — OpenRouter ───────────────────────────────────────────────────────────
# API key from https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-...
# Model identifier — default: google/gemini-2.5-flash
OPENROUTER_MODEL=google/gemini-2.5-flash


# ── AI — Azure AI Foundry (alternative to OpenRouter) ────────────────────────
# Azure AI Foundry resource endpoint URL
AZURE_AI_FOUNDRY_ENDPOINT=https://your-resource.openai.azure.com/
# Azure AI Foundry API key
AZURE_AI_FOUNDRY_API_KEY=your-azure-api-key
# Deployed model name (e.g. gpt-4o, gpt-4o-mini)
AZURE_AI_FOUNDRY_DEPLOYMENT_NAME=gpt-4o


# ── EMAIL (Resend) ────────────────────────────────────────────────────────────
# API key from https://resend.com/api-keys
RESEND_API_KEY=re_...
# Verified sender address — domain must be verified in the Resend dashboard
RESEND_FROM_EMAIL=notifications@yourdomain.co.uk
# Optional: display name in the From header
RESEND_FROM_NAME=KO Platform
# Optional: reply-to address
RESEND_REPLY_TO=support@yourdomain.co.uk
# Optional: webhook secret for Resend inbound email events
# RESEND_WEBHOOK_SECRET=whsec_...

# Message email digest delay — how long to wait before sending a digest email.
# Default: 4 hours. For local testing you can use milliseconds instead.
# MESSAGE_EMAIL_DIGEST_DELAY_HOURS=4
# MESSAGE_EMAIL_DIGEST_DELAY_MS=60000


# ── SMS (Twilio) ──────────────────────────────────────────────────────────────
# Account SID — from https://console.twilio.com
TWILIO_ACCOUNT_SID=AC...
# Auth token — from https://console.twilio.com (server-side only, keep secret)
TWILIO_AUTH_TOKEN=
# Your Twilio phone number in E.164 format (e.g. +441234567890)
TWILIO_FROM_NUMBER=+44...


# ── FILE STORAGE (Cloudflare R2) ──────────────────────────────────────────────
# Cloudflare account ID — Cloudflare Dashboard → R2
R2_ACCOUNT_ID=
# R2 API token — Cloudflare Dashboard → R2 → Manage R2 API Tokens
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# R2 bucket name for document uploads
R2_BUCKET_NAME=ko-broker-docs
# Public URL of the bucket (custom domain or .r2.dev subdomain)
R2_PUBLIC_URL=https://storage.yourdomain.co.uk


# ── BILLING (Stripe) ──────────────────────────────────────────────────────────
# Use test keys for development — https://dashboard.stripe.com/test/apikeys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
# Webhook signing secret — Stripe Dashboard → Webhooks
# Local testing: stripe listen --forward-to localhost:3001/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Price IDs — create in Stripe Dashboard → Products
# Plans: Starter £35/mo, Professional £50/mo, Enterprise £75/mo
STRIPE_PRICE_STARTER_MONTHLY=price_...
STRIPE_PRICE_STARTER_YEARLY=price_...
STRIPE_PRICE_PROFESSIONAL_MONTHLY=price_...
STRIPE_PRICE_PROFESSIONAL_YEARLY=price_...
STRIPE_PRICE_ENTERPRISE_MONTHLY=price_...
STRIPE_PRICE_ENTERPRISE_YEARLY=price_...


# ── APPLICATION URLs ──────────────────────────────────────────────────────────
# Public URL of the broker dashboard (Next.js app, port 3001 locally)
NEXT_PUBLIC_APP_URL=http://localhost:3001
# Internal API base URL — same as APP_URL for a self-contained Next.js app
NEXT_PUBLIC_API_URL=http://localhost:3001
# Public URL of the client portal app (separate Next.js app, port 3002 locally)
NEXT_PUBLIC_CLIENT_PORTAL_URL=http://localhost:3002


# ── SECURITY ──────────────────────────────────────────────────────────────────
# Secret for signing client portal session JWT cookies.
# Required in production. Generate with: openssl rand -hex 32
PORTAL_SESSION_SECRET=change-me-in-production

# Allowed CORS origins for API routes (comma-separated). Optional.
# CORS_ALLOWED_ORIGINS=https://app.yourdomain.co.uk,https://portal.yourdomain.co.uk


# ── CRON JOBS ─────────────────────────────────────────────────────────────────
# All four cron routes require: Authorization: Bearer {CRON_SECRET}
# Required in production — the routes return 503 if this is missing.
# Generate with: openssl rand -hex 32
CRON_SECRET=change-me-in-production


# ── FCA FS REGISTER API — lender directory sync (PRD-16) ─────────────────────
# Used by POST /api/cron/lenders-fca — runs monthly on the 1st of each month.
# Keeps the lender directory current by syncing against the FCA register.
# Without these the cron returns HTTP 503. Lender search still works from the
# 189-name seed; this cron adds newly authorised lenders over time.
#
# Free registration: https://register.fca.org.uk/developer/s/
# Auth headers used: X-Auth-Email + X-Auth-Key
# Rate limit: 10 requests per 10 seconds (ingest uses 1200ms delay)
FCA_API_EMAIL=your@email.com
FCA_API_KEY=your-fca-api-key


# ── FEATURE FLAGS (optional) ──────────────────────────────────────────────────
# Set to "true" to enforce Stripe plan limits in the API and UI.
# KO_ENFORCE_PLAN_LIMITS=true
# NEXT_PUBLIC_ENFORCE_PLAN_LIMITS=true
