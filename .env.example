# ============================================
# KO Broker Platform — Environment Variables
# ============================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to the repository.
# ============================================

# ── DATABASE (Supabase) ──────────────────────
# Connection pooler URL — used by the app at runtime
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true"
# Direct connection URL — used only for Prisma migrations (bypasses pooler)
DIRECT_URL="postgresql://user:password@host:5432/postgres"

# ── AUTHENTICATION (Clerk) ───────────────────
# Publishable key — safe to expose in the browser
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
# Secret key — server-side only
CLERK_SECRET_KEY="sk_test_..."
# Webhook signing secret (svix) — for verifying Clerk webhook payloads
CLERK_WEBHOOK_SECRET="whsec_..."

# Clerk redirect URLs
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/dashboard"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/dashboard"

# ── AI (Azure AI Foundry) ────────────────────
# Azure AI Foundry endpoint URL (e.g. https://<resource>.openai.azure.com/)
AZURE_AI_FOUNDRY_ENDPOINT="https://your-resource.openai.azure.com/"
# API key for the Azure AI Foundry resource
AZURE_AI_FOUNDRY_API_KEY="your-api-key"
# Deployed model name (e.g. gpt-4o, gpt-4o-mini, phi-4)
AZURE_AI_FOUNDRY_DEPLOYMENT_NAME="gpt-4o"

# ── FILE STORAGE (Cloudflare R2) ─────────────
# Cloudflare account ID
R2_ACCOUNT_ID=""
# R2 access credentials (generate in Cloudflare dashboard)
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
# R2 bucket name for document storage
R2_BUCKET_NAME="ko-documents"

# ── EMAIL (Resend) ───────────────────────────
# API key from Resend dashboard
RESEND_API_KEY="re_..."
# Verified sender address
RESEND_FROM_EMAIL="notifications@koplatform.co.uk"

# ── SMS (Twilio) ─────────────────────────────
# Twilio account credentials
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
# Twilio phone number (E.164 format, e.g. +44...)
TWILIO_FROM_NUMBER=""

# ── APPLICATION ──────────────────────────────
# Public URL of the application (used in email links, OAuth callbacks)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── DEMO LOGIN (staging gate until Clerk — PRD-04) ──
# Usernames (fixed): KingOlu | Development
# Passwords must be at least 12 characters. Prefer base64: encoding for $ in passwords.
# Copy values from your ko-platform .env (VITE_AUTH_* → NEXT_PUBLIC_AUTH_*).
NEXT_PUBLIC_AUTH_KINGOLU_PASSWORD=
NEXT_PUBLIC_AUTH_DEVELOPMENT_PASSWORD=
