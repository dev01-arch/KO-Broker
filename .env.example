# ── AI (Azure AI Foundry) ────────────────────
# Azure AI Foundry endpoint URL (e.g. https://<resource>.openai.azure.com/)
AZURE_AI_FOUNDRY_ENDPOINT="https://your-resource.openai.azure.com/"
# API key for the Azure AI Foundry resource
AZURE_AI_FOUNDRY_API_KEY="your-api-key"
# Deployed model name (e.g. gpt-4o, gpt-4o-mini, phi-4)
AZURE_AI_FOUNDRY_DEPLOYMENT_NAME="gpt-4o"

# ── FILE STORAGE (Cloudflare R2) ─────────────
# Cloudflare account ID
R2_ACCOUNT_ID=""
# R2 access credentials (generate in Cloudflare dashboard)
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
# R2 bucket name for document storage
R2_BUCKET_NAME="ko-documents"

# ── EMAIL (Resend) ───────────────────────────
# API key from Resend dashboard
#RESEND_API_KEY="re_..."
# Verified sender address (domain must be verified in Resend dashboard)
#RESEND_FROM_EMAIL="notifications@koplatform.co.uk"
# Optional display name for the From header
# RESEND_FROM_NAME="KO Platform"
# Optional reply-to address
# RESEND_REPLY_TO="support@koplatform.co.uk"

# ── SMS (Twilio) ─────────────────────────────
# Twilio account credentials
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
# Twilio phone number (E.164 format, e.g. +44...)
TWILIO_FROM_NUMBER=""

# ── APPLICATION ──────────────────────────────
# Public URL of the application (used in email links, OAuth callbacks)
NEXT_PUBLIC_APP_URL="http://localhost:3001"

# Backend API base URL for the dashboard CRM client.
# Local dev: same host as the Next.js app (implements /api/clients).
# Production: your deployed app URL once API routes are live.
NEXT_PUBLIC_API_URL="http://localhost:3001"

# Public URL of the client portal (used in invite email/SMS links)
NEXT_PUBLIC_CLIENT_PORTAL_URL="http://localhost:3002"

# Secret for signing client_session JWT cookies (required in production)
PORTAL_SESSION_SECRET="change-me-in-production"
# KO_ENFORCE_PLAN_LIMITS=true
# NEXT_PUBLIC_ENFORCE_PLAN_LIMITS=true

