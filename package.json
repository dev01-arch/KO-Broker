{
  "name": "ko-broker-platform",
  "private": true,
  "packageManager": "pnpm@10.30.1",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @ko/web dev",
    "build": "pnpm --filter @ko/web build",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "db:generate": "pnpm --filter @ko/db generate",
    "db:push": "pnpm --filter @ko/db push",
    "db:seed": "pnpm --filter @ko/db seed",
    "db:migrate": "pnpm --filter @ko/db migrate",
    "clean": "pnpm -r run clean"
  }
}
